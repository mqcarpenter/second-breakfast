# Copy to deploy/.env on the server. Never commit .env.
# Generate secrets on the server with umask 077; do not paste them anywhere else.

# Hostname Caddy serves, without scheme. Resolved by mDNS (see README).
JOURNAL_HOST=<name>.local
DOMAIN_NAME=<name>.local
DOMAIN_SCHEME=https

# Generate on the server:  openssl rand -base64 32
SECRET_KEY=
POSTGRES_PASSWORD=

# Set to true after the first account exists.
DISABLE_SIGNUP=false

# Host paths. Postgres and Valkey must be on local disk.
DATA_DIR=./data
MEDIA_DIR=./data/media
IMPORTS_DIR=./data/imports

# Host ports for Caddy. Change only if 80/443 are taken.
# CADDY_HTTPS_PORT=443
# CADDY_HTTP_PORT=80
