# TLS comes from Caddy's own private CA, so no public CA, domain or DNS token is
# involved. Trust the CA root once on each device (see README.md).
{
	local_certs
}

{$JOURNAL_HOST} {
	encode zstd gzip
	reverse_proxy app:8000
}

# Plain HTTP serves only the public CA root (for installing on the phone).
# Everything else is sent to HTTPS.
http://{$JOURNAL_HOST} {
	handle /root.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		file_server
	}
	handle {
		redir https://{host}{uri} permanent
	}
}
